# ============================================================
# LigmaFirewall — environment configuration
# Copy to .env and fill in your values.
# ============================================================

# LLM — required
OPENAI_API_KEY=

# Optional: override the model used by all agents
# AGENT_MODEL=openai:gpt-4o-mini

# ------------------------------------------------------------
# GitHub MCP (github-mcp-server)
# Any one of these token names is accepted.
# Scopes needed: repo, read:org, read:packages
# ------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=
# GITHUB_TOKEN=
# GITHUB_PAT=

# Toolsets to expose from the GitHub MCP server
GITHUB_TOOLSETS=context,repos,pull_requests,actions,code_security,dependabot

# Read-only mode for GitHub MCP (recommended: 1)
GITHUB_READ_ONLY=1

# Optional: use GitHub's remote MCP endpoint instead of local Docker/npx
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# ------------------------------------------------------------
# Semgrep MCP (semgrep mcp subcommand)
# Install: pip install semgrep  OR  brew install semgrep  OR  use uvx/Docker (auto-detected)
# Docs:    https://semgrep.dev/docs/mcp
# ------------------------------------------------------------
# Optional: enables AppSec Platform findings via semgrep_findings tool
# SEMGREP_APP_TOKEN=

# ------------------------------------------------------------
# Jenkins (real API — no MCP server required)
# ------------------------------------------------------------
# JENKINS_URL=https://your-jenkins.example.com
# JENKINS_USER=admin
# JENKINS_TOKEN=your-api-token

# Optional: HTTP MCP endpoint for Jenkins (alternative to above)
# JENKINS_MCP_URL=

# ------------------------------------------------------------
# Filesystem MCP (@modelcontextprotocol/server-filesystem)
# Colon-separated list of allowed root directories (requires npx)
# ------------------------------------------------------------
FILESYSTEM_MCP_ROOTS=.

# Disable filesystem MCP entirely
# FILESYSTEM_MCP_DISABLED=1

# ------------------------------------------------------------
# Custom Security MCP (optional — for cloud IAM integration)
# Point to a deployed security MCP server for AWS/GCP/Azure IAM auditing
# ------------------------------------------------------------
# SECURITY_MCP_URL=

# Optional: REST endpoint for cloud IAM tools (list_iam_policies etc.)
# IAM_API_URL=

# ------------------------------------------------------------
# LangSmith tracing (optional)
# ------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ligma-firewall

# ------------------------------------------------------------
# Tuning
# ------------------------------------------------------------
MCP_LOAD_TIMEOUT_SECONDS=12

# Security audits should not mutate repos or files by default.
MCP_READ_ONLY=1
